# Copy to .env and fill in. NEVER commit .env.
# Local dev defaults work out of the box; production values come from
# the hosting provider's env config (Koyeb / Vercel / Supabase dashboard).

# Local postgres (docker-compose)
POSTGRES_PASSWORD=localdev-only

# Backend -> database
DATABASE_URL=
DB_PASSWORD=localdev-only

# Auth
JWT_SECRET=local-dev-secret-change-in-prod

# External APIs
GROQ_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Data loading (one-off scripts)
SUPABASE_DB_PASSWORD=
